# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of a sandbox account that receives the goal payment (Testing Tools > Sandbox Accounts)
MERCHANT_EMAIL=
# Google AI Studio key (aistudio.google.com)
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-3.8-flash
# Optional, comma separated: tried when the main model is busy
GEMINI_FALLBACK_MODELS=
CURRENCY=USD
PORT=3000
